#Requires AutoHotkey v2.0

; ===================================================
; [NumLock이 ON(켜짐) 상태일 때만 동작하는 매핑 구역]
; ===================================================
#HotIf GetKeyState("NumLock", "T")

; 1. 상단 숫자키 ➔ 특수문자 변환
1::Send("+1") ; !
2::Send("+2") ; @
3::Send("+3") ; #
4::Send("+4") ; $
5::Send("+5") ; %
6::Send("+6") ; ^
7::Send("+7") ; &
8::Send("+8") ; *
9::Send("+9") ; (
0::Send("+0") ; )

; 2. F키 매핑 (복사 / 잘라내기 / 붙여넣기)
F2::Send("^c") ; 복사 (Ctrl + C)
F3::Send("^x") ; 잘라내기 (Ctrl + X)
F4::Send("^v") ; 붙여넣기 (Ctrl + V)

#HotIf
; ===================================================
; [NumLock이 OFF(꺼짐) 상태일 때는 원래대로 동작합니다]
; ===================================================